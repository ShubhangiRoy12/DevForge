# Frontend
VITE_API_BASE_URL=http://localhost:8080

# Backend
DEVFORGE_DB_URL=jdbc:h2:file:./data/devforge
DEVFORGE_DB_USERNAME=sa
DEVFORGE_DB_PASSWORD=

# Hosted session and browser security
APP_CORS_ALLOWED_ORIGIN=https://your-devforge-frontend.example
DEVFORGE_SESSION_COOKIE_SECURE=true
# Keep "lax" when frontend and API share a site. Use "none" only for HTTPS cross-site hosting.
DEVFORGE_SESSION_COOKIE_SAME_SITE=lax
